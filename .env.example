# Copy to .env (or set these directly in your deployment) and adjust.

# Path to the SQLite file sessionkit stores accounts/sessions/2FA in.
# Provision the first account against this same path:
#   sessionkit add you@example.com --db ./auth.db
#
# DEPLOYED (not local dev): this MUST be an absolute path inside the data/
# directory deploy/remote-setup.sh creates - e.g. /opt/identity-system/data/auth.db
# - not the relative default below. deploy.sh's rsync --delete wipes
# anything under the app directory that isn't there on every deploy; only
# data/ (and *.db/*.db-* as a second safety net) is excluded from that
# sweep, so a db file left at this relative default (or anywhere else
# outside data/) gets deleted the next time this is deployed. See
# deploy/identity-system-api.service's header comment.
IDENTITY_SYSTEM_DB=./auth.db

# The parent domain the session cookie is scoped to, and the only domain
# (plus its subdomains) a post-login redirect (?rd=) is allowed to target.
# e.g. ".example.com" so the cookie and redirects work across
# app1.example.com, app2.example.com, ...
IDENTITY_SYSTEM_COOKIE_DOMAIN=.example.com

# Set to "false" only for local HTTP development - the cookie is Secure by
# default, which browsers refuse to send back over plain HTTP.
IDENTITY_SYSTEM_COOKIE_SECURE=true

# Session lifetime, in days.
IDENTITY_SYSTEM_SESSION_DAYS=30

# Shown as the TOTP issuer in authenticator apps.
IDENTITY_SYSTEM_ISSUER=identity-system

# Comma-separated emails allowed to view the admin page (registered users +
# last login time). Empty by default - nobody can reach it until this is
# set. Case-insensitive; no in-app role management, edit + restart to change.
IDENTITY_SYSTEM_ADMIN_EMAILS=you@example.com

# Path to the static apps-directory JSON the "/" page lists (see apps.json
# at the repo root for the format). Not live-reloaded - restart to pick up
# a change. Missing file -> empty list, not an error.
IDENTITY_SYSTEM_APPS_PATH=./apps.json

# --- OIDC (for relying parties like Jenkins' OpenID Connect plugin) -------

# The real, externally-reachable origin this service is served at - used
# as the OIDC `iss` claim and to build every URL in the discovery document
# (GET /.well-known/openid-configuration). NOT the same thing as
# IDENTITY_SYSTEM_ISSUER above (that's just sessionkit's TOTP label) - this
# one has to be a real URL, with no trailing slash, e.g.
# https://sso.example.com.
IDENTITY_SYSTEM_OIDC_ISSUER_URL=https://sso.example.com

# Path to the static OIDC client registry (see oidc_clients.json.example
# at the repo root for the format and README.md#registering-an-oidc-client
# for how to generate a client_secret_hash). Holds credentials, so unlike
# apps.json this one is NOT meant to be committed - gitignored, and
# excluded from deploy.sh's rsync the same way .env is. Missing file -> no
# clients registered, every /api/oidc/authorize request is rejected.
IDENTITY_SYSTEM_OIDC_CLIENTS_PATH=./oidc_clients.json

# Path to the RSA keypair (PEM) used to sign ID/access tokens - generated
# automatically on first run if this file doesn't exist yet.
#
# DEPLOYED (not local dev): same rule as IDENTITY_SYSTEM_DB above - this
# MUST resolve inside the data/ directory deploy/remote-setup.sh creates,
# or deploy.sh's rsync --delete silently deletes it (and a fresh one gets
# generated next startup, which rotates the signing key and breaks every
# relying party until they re-fetch /api/oidc/jwks.json). remote-setup.sh
# checks this and warns loudly - don't remove that check.
IDENTITY_SYSTEM_OIDC_SIGNING_KEY_PATH=./data/oidc_signing_key.pem
