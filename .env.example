# Copy to .env (or set these directly in your deployment) and adjust.

# Path to the SQLite file sessionkit stores accounts/sessions/2FA in.
# Provision the first account against this same path:
#   sessionkit add you@example.com --db ./auth.db
IDENTITY_SYSTEM_DB=./auth.db

# The parent domain the session cookie is scoped to, and the only domain
# (plus its subdomains) a post-login redirect (?rd=) is allowed to target.
# e.g. ".example.com" so the cookie and redirects work across
# app1.example.com, app2.example.com, ...
IDENTITY_SYSTEM_COOKIE_DOMAIN=.example.com

# Set to "false" only for local HTTP development - the cookie is Secure by
# default, which browsers refuse to send back over plain HTTP.
IDENTITY_SYSTEM_COOKIE_SECURE=true

# Session lifetime, in days.
IDENTITY_SYSTEM_SESSION_DAYS=30

# Shown as the TOTP issuer in authenticator apps.
IDENTITY_SYSTEM_ISSUER=identity-system

# Comma-separated emails allowed to view the admin page (registered users +
# last login time). Empty by default - nobody can reach it until this is
# set. Case-insensitive; no in-app role management, edit + restart to change.
IDENTITY_SYSTEM_ADMIN_EMAILS=you@example.com

# Path to the static apps-directory JSON the "/" page lists (see apps.json
# at the repo root for the format). Not live-reloaded - restart to pick up
# a change. Missing file -> empty list, not an error.
IDENTITY_SYSTEM_APPS_PATH=./apps.json
